  "descriptionSection": {
    "title": "Limestone",
    "introduction": {
      "type": "document",
      "content": [
        {
          "type": "p",
          "content": [
            {
              "type": "text",
              "value": "Limestone is ripe for innovation, if you know what to do with it. We relish the stone\u2019s endless textural and tonal opportunities with our extensive range of limestone tiles. Flexible, malleable and high-performing, it\u2019s the dream material to work with. We source only the very best raw limestone and work with it to craft interesting, experimental and timeless forms that embrace the material\u2019s true potential. ",
              "marks": []
            }
          ]
        }
      ]
    },
