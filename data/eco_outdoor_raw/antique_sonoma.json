  "seo": {
    "title": "Sonoma Antique Limestone Flooring",
    "description": "Discover the timeless beauty of Sonoma limestone flooring pavers. With a distressed surface finish, chiselled edges, and natural imperfections, these durable tiles bring tactile elegance to gardens and interiors.",
    "keywords": "",
    "noIndex": false,
    "canonicalUrl": ""
  },
